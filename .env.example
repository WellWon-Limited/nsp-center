# Names of the environment variables the project reads. No values here.
# Local server (scripts/serve.mjs): port and listen address; defaults 5217 and 127.0.0.1.
PORT=
HOST=
# Accounts database (scripts/accounts.mjs): postgres://user:password@host:port/db. Empty: accounts stay in the browser.
# Locally npm run db:local writes it into .env.
DATABASE_URL=
# Administrators of the site (comma-separated emails); more can be appointed in «Управление сайтом».
ADMIN_EMAILS=
# HTTP tests and canvas checks against a running server, e.g. http://127.0.0.1:5217
NSP_TEST_URL=
# Isolated Factory canvas run (scripts/check-canvas.mjs)
WW_TEST=
WW_TEST_ID=
# Consultation agent (scripts/ai-agent.mjs): YandexGPT key and folder of Yandex AI Studio. Empty: prepared answers only.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
AI_DAILY_LIMIT=
AI_MONTHLY_LIMIT_RUB=
AI_PRICE_PER_1K_RUB=
AI_CORPUS_FILE=
