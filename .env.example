# Names of the environment variables the project reads. No values here.
# Web process: export these in its environment; it does not load the secret .env file.
PORT=
HOST=
# Separate API. Defaults: 127.0.0.1:8701. API_ORIGIN belongs to the web process.
API_HOST=
API_PORT=
API_ORIGIN=
# Optional local Unix socket, set identically for API and web; takes precedence over TCP.
API_SOCKET=
# Only behind a trusted HTTPS reverse proxy, for secure session cookies.
TRUST_PROXY=
# API_DATABASE_URL is for compose; use a database host reachable from its container.
API_DATABASE_URL=
# API database (apps/api/accounts.mjs): postgres://user:password@host:port/db. Empty: accounts stay in the browser.
# Locally npm run db:local writes it into .env.
DATABASE_URL=
# HTTP tests and canvas checks against a running server, e.g. http://127.0.0.1:5217
NSP_TEST_URL=
# Isolated Factory canvas run (scripts/check-canvas.mjs)
WW_TEST=
WW_TEST_ID=
# Consultation agent (scripts/ai-agent.mjs): YandexGPT key and folder of Yandex AI Studio. Empty: prepared answers only.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
AI_DAILY_LIMIT=
AI_MONTHLY_LIMIT_RUB=
AI_PRICE_PER_1K_RUB=
AI_CORPUS_FILE=
