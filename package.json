{
  "name": "nsp-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "content": "node scripts/extract-prototype.mjs && node scripts/import-content.mjs && node scripts/split-content.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run content && npm run typecheck && vite build && node scripts/prerender.mjs && node scripts/pwa.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "npm run build && npm test && node scripts/check-content.mjs",
    "check:canvas": "node scripts/check-canvas.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:seed": "node scripts/seed-test-accounts.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
